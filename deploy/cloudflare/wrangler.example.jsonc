{
  "name": "dashain-cards-dev",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomCoordinator"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://cards.example.com,http://localhost:4173,http://127.0.0.1:4173"
  },
  "observability": {
    "enabled": false
  }
}
